# Copiar a `.env.local` (gitignored) y rellenar.
# Key gratis: https://carto.com/basemaps/apikey
# En Vercel: Project → Settings → Environment Variables (luego redeploy).

# Carto basemap key (query param `?key=`). Prefijo VITE_ → va al bundle del cliente.
VITE_CARTO_API_KEY=

# Canonical site origin for SEO (Open Graph, canonical, sitemap).
# Sin trailing slash. Producción actual: https://enjambreapp.vercel.app
# Opcional en Vercel mientras el build use el default de apps/web/site.ts.
VITE_SITE_URL=https://enjambreapp.vercel.app
